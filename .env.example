# Required
DISCORD_TOKEN=your-bot-token-here

# Optional
FFMPEG_PATH=ffmpeg                 # full path to ffmpeg.exe if it's not on PATH
COOKIES_FILE=cookies.txt           # YouTube cookies (helps with age/region-restricted videos)
STARTUP_CHANNEL_ID=                # channel to post "Bot is online" in
IDLE_TIMEOUT=300                   # seconds before leaving an idle/empty voice channel
VOLUME=0.25                        # 0.0 - 1.0
